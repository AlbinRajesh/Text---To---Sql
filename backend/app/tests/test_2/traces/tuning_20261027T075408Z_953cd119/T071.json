  "question": "which pincode has the most shops?",
  "golden_sql": "SELECT sa.pincode, COUNT(sd.id) AS shop_count FROM shop_address sa JOIN shop_details sd ON sd.id = sa.shop_id WHERE sa.is_default = 1 AND sd.status = 1 GROUP BY sa.pincode ORDER BY shop_count DESC LIMIT 1;",
