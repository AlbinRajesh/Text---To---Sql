# MySQL metadata/schema connection
MYSQL_HOST=TODO_MYSQL_PRIMARY_HOST
MYSQL_USER=TODO_MYSQL_METADATA_USER
MYSQL_PASSWORD=TODO_MYSQL_METADATA_PASSWORD
MYSQL_DATABASE=TODO_MYSQL_DATABASE
MYSQL_PORT=3306
MYSQL_POOL_MIN_SIZE=1
MYSQL_POOL_MAX_SIZE=10

# Read-only query execution connection. Grant SELECT only on approved tables.
MYSQL_READ_REPLICA_HOST=TODO_MYSQL_READ_REPLICA_HOST
MYSQL_READ_ONLY_USER=TODO_MYSQL_READ_ONLY_USER
MYSQL_READ_ONLY_PASSWORD=TODO_MYSQL_READ_ONLY_PASSWORD
MYSQL_READ_REPLICA_DATABASE=TODO_MYSQL_DATABASE
MYSQL_READ_REPLICA_PORT=3306
MYSQL_READ_POOL_MIN_SIZE=1
MYSQL_READ_POOL_MAX_SIZE=10

# Agent LLM roles. Supported providers: groq, gemini.
# Replace every TODO model and key value before running the backend.
CLASSIFIER_PROVIDER=groq
CLASSIFIER_MODEL=TODO_SUPPORTED_MODEL_NAME
CLASSIFIER_API_KEY=TODO_GROQ_API_KEY

SCHEMA_GRADER_PROVIDER=groq
SCHEMA_GRADER_MODEL=TODO_SUPPORTED_MODEL_NAME
SCHEMA_GRADER_API_KEY=TODO_GROQ_API_KEY

QUERY_GENERATOR_PROVIDER=gemini
QUERY_GENERATOR_MODEL=TODO_SUPPORTED_MODEL_NAME
QUERY_GENERATOR_API_KEY=TODO_GEMINI_API_KEY

RESULT_GRADER_PROVIDER=groq
RESULT_GRADER_MODEL=TODO_SUPPORTED_MODEL_NAME
RESULT_GRADER_API_KEY=TODO_GROQ_API_KEY

# Optional local Redis fast path for one-time suggestion plans.
SUGGESTION_REDIS_URL=redis://localhost:6379/0

# Clarification notes require Redis in production; development may use memory.
APP_ENV=development
PENDING_CLARIFICATION_TTL_SECONDS=600

# Optional settings (these match application defaults).
SCHEMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SCHEMA_EMBEDDING_CACHE_DIR=models_cache
USE_QUESTION_REWRITE=true
MAX_RETRIES=3
LLM_BASE_BACKOFF_SECONDS=1.0
LLM_TIMEOUT_SECONDS=30.0
LLM_FAST_FALLBACK_TIMEOUT_SECONDS=30.0
# Optional fast model used once for non-streaming JSON after a 30-second timeout.
# A per-role override can be supplied as <ROLE>_FAST_MODEL.
LLM_FAST_FALLBACK_MODEL=TODO_SUPPORTED_FAST_MODEL_NAME
# Optional provider/model failover after persistent HTTP 429/5xx failures.
# Configure LLM_BACKUP_MODEL and, when needed, LLM_BACKUP_PROVIDER and
# LLM_BACKUP_API_KEY. Per-role overrides use <ROLE>_BACKUP_*.
LLM_BACKUP_PROVIDER=groq
LLM_BACKUP_MODEL=TODO_SUPPORTED_BACKUP_MODEL_NAME
LLM_BACKUP_API_KEY=TODO_BACKUP_API_KEY
LLM_BACKUP_TIMEOUT_SECONDS=30.0
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0
LLM_MAX_RETRY_AFTER_SECONDS=60
LLM_RATE_LIMIT_FLOOR_SECONDS=10
LOG_RETRY_PROMPT=false
ESCALATION_AUDIT_LOG_PATH=logs/escalations.jsonl

# Optional only for the standalone MongoDB helper/manual smoke test.
# MONGO_URI=mongodb://TODO_MONGODB_HOST:27017
# MONGO_DB_NAME=TODO_MONGODB_DATABASE
