    "matched_business_rules": [
      {
        "term": "shops_with_all_offers_having_all_images",
        "synonyms": [
          "uploaded all 3 product images for their offers",
          "all offers have all images",
          "every offer has 3 images"
        ],
        "definition": "To find shops where EVERY offer has all 3 images, require at least one offer and exclude any shop that has at least one offer missing an image. Use the NOT IN anti-join with shop_id IS NOT NULL to avoid NULL poisoning: offer.product_img1 IS NULL OR offer.product_img2 IS NULL OR offer.product_img3 IS NULL. This is universal quantification across all offers, not a search for shops with one complete offer.",
        "canonical_sql_pattern": "SELECT DISTINCT sd.id, sd.name FROM shop_details sd WHERE EXISTS (SELECT 1 FROM offer o WHERE o.shop_id = sd.id) AND sd.id NOT IN (SELECT o.shop_id FROM offer o WHERE o.shop_id IS NOT NULL AND (o.product_img1 IS NULL OR o.product_img2 IS NULL OR o.product_img3 IS NULL))"
      }
    ],
