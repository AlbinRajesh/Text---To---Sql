    "matched_business_rules": [
      {
        "term": "category_view_booking_comparison",
        "synonyms": [
          "views versus bookings by category",
          "compare views and bookings across categories",
          "view-to-booking comparison by category",
          "view-to-booking ratio by category",
          "booking efficiency by category"
        ],
        "target_table": "categories",
        "definition": "Compare category-level view and booking counts using independent grouped subqueries, never by joining views and bookings together in the same aggregate input. Aggregate views and bookings separately through their verified many-to-one paths to shop_details and categories, then join each result by category id. Represent each metric as a separate isolated_child_aggregates operation with its verified relationship_path; do not use a cross-joined child metric plan.",
        "canonical_sql_pattern": "SELECT c.categoriesname, COALESCE(v.total_views, 0) AS total_views, COALESCE(b.total_bookings, 0) AS total_bookings, COALESCE(v.total_views, 0) / NULLIF(COALESCE(b.total_bookings, 0), 0) AS view_booking_ratio FROM categories c LEFT JOIN (SELECT sd.category_id, COUNT(v.id) AS total_views FROM views v JOIN shop_details sd ON v.shop_id = sd.id GROUP BY sd.category_id) v ON v.category_id = c.id LEFT JOIN (SELECT sd.category_id, COUNT(b.id) AS total_bookings FROM bookings b JOIN shop_details sd ON b.shop_id = sd.id GROUP BY sd.category_id) b ON b.category_id = c.id"
      }
    ],
